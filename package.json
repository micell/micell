{
  "name": "micell",
  "version": "1.0.0",
  "description": "A collection of functions for frontend development",
  "type": "module",
  "main": "./dist/micell.es.js",
  "module": "./dist/micell.es.js",
  "types": "./dist/micell.d.ts",
  "exports": {
    ".": {
      "types": "./dist/micell.d.ts",
      "import": "./dist/micell.es.js"
    },
    "./base64": {
      "types": "./dist/base64.d.ts",
      "import": "./dist/base64.es.js"
    },
    "./char": {
      "types": "./dist/char.d.ts",
      "import": "./dist/char.es.js"
    },
    "./cookie": {
      "types": "./dist/cookie.d.ts",
      "import": "./dist/cookie.es.js"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "import": "./dist/date.es.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.es.js"
    },
    "./easing": {
      "types": "./dist/easing.d.ts",
      "import": "./dist/easing.es.js"
    },
    "./emitter": {
      "types": "./dist/emitter.d.ts",
      "import": "./dist/emitter.es.js"
    },
    "./lang": {
      "types": "./dist/lang.d.ts",
      "import": "./dist/lang.es.js"
    },
    "./path": {
      "types": "./dist/path.d.ts",
      "import": "./dist/path.es.js"
    },
    "./qs": {
      "types": "./dist/qs.d.ts",
      "import": "./dist/qs.es.js"
    },
    "./regex": {
      "types": "./dist/regex.d.ts",
      "import": "./dist/regex.es.js"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "import": "./dist/string.es.js"
    },
    "./ua": {
      "types": "./dist/ua.d.ts",
      "import": "./dist/ua.es.js"
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "import": "./dist/url.es.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "UPGRADING.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "lint": "oxlint src test",
    "fmt": "oxfmt src test",
    "fmt:check": "oxfmt --check src test",
    "type-check": "tsc --noEmit",
    "type-check:watch": "pnpm run type-check -- --watch",
    "vitest": "vitest",
    "test": "vitest",
    "test:ci": "vitest run --browser.headless",
    "test:cover": "vitest --coverage",
    "test:ci:cover": "vitest run --coverage --browser.headless",
    "build": "pnpm run clean && tsup",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changelog": "changelogen",
    "release": "bumpp -a --commit \"chore(release): {version}\"",
    "release:tag": "node scripts/release-tag.mjs",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/micell/micell.git"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "docs/**/*.ts": [
      "oxfmt --write"
    ]
  },
  "keywords": [
    "micell",
    "utility",
    "util",
    "base64",
    "cookie",
    "date",
    "dom",
    "easing",
    "emitter",
    "path",
    "qs",
    "querystring",
    "regex",
    "string",
    "ua",
    "useragent",
    "url"
  ],
  "author": "Alex Chao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/micell/micell/issues"
  },
  "homepage": "https://micell.org",
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "bumpp": "^12.2.2",
    "changelogen": "^0.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.41.0",
    "playwright": "^1.65.0",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitepress": "^2.0.0-alpha.21",
    "vitest": "^4.1.11"
  }
}
